{
  "manifest_version": 3,
  "name": "Skyhop Airline Assist",
  "version": "0.8.0",
  "description": "From a Skyhop flight result, open the airline's own site in a new tab with that flight already selected, so you can finish booking it yourself.",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://*.aa.com/*",
    "https://*.aegeanair.com/*",
    "https://*.aeromexico.com/*",
    "https://*.air.bg/*",
    "https://*.airarabia.com/*",
    "https://*.airastana.com/*",
    "https://*.airbaltic.com/*",
    "https://*.aircanada.com/*",
    "https://*.airchina.com/*",
    "https://*.aireuropa.com/*",
    "https://*.airfrance.com/*",
    "https://*.airindia.com/*",
    "https://*.airmoldova.md/*",
    "https://*.airserbia.com/*",
    "https://*.airtransat.com/*",
    "https://*.ajet.com/*",
    "https://*.arkia.co.il/*",
    "https://*.arkia.com/*",
    "https://*.austrian.com/*",
    "https://*.azal.az/*",
    "https://*.bluebirdair.com/*",
    "https://*.britishairways.com/*",
    "https://*.brusselsairlines.com/*",
    "https://*.cathaypacific.com/*",
    "https://*.copaair.com/*",
    "https://*.croatiaairlines.com/*",
    "https://*.csa.cz/*",
    "https://*.cyprusairways.com/*",
    "https://*.delta.com/*",
    "https://*.discover-airlines.com/*",
    "https://*.easyjet.com/*",
    "https://*.egyptair.com/*",
    "https://*.elal.com/*",
    "https://*.emirates.com/*",
    "https://*.ethiopianairlines.com/*",
    "https://*.etihad.com/*",
    "https://*.eurowings.com/*",
    "https://*.finnair.com/*",
    "https://*.flydubai.com/*",
    "https://*.flypgs.com/*",
    "https://*.flysas.com/*",
    "https://*.flytap.com/*",
    "https://*.georgian-airways.com/*",
    "https://*.gulfair.com/*",
    "https://*.hainanairlines.com/*",
    "https://*.hisky.com/*",
    "https://*.iberia.com/*",
    "https://*.israir.co.il/*",
    "https://*.ita-airways.com/*",
    "https://*.klm.com/*",
    "https://*.lot.com/*",
    "https://*.lufthansa.com/*",
    "https://*.rj.com/*",
    "https://*.ryanair.com/*",
    "https://*.skyexpress.gr/*",
    "https://*.sunexpress.com/*",
    "https://*.swiss.com/*",
    "https://*.tarom.ro/*",
    "https://*.thaiairways.com/*",
    "https://*.transavia.com/*",
    "https://*.turkishairlines.com/*",
    "https://*.tusairways.com/*",
    "https://*.united.com/*",
    "https://*.uzairways.com/*",
    "https://*.virginatlantic.com/*",
    "https://*.vueling.com/*",
    "https://*.wizzair.com/*",
    "http://127.0.0.1:8799/*",
    "http://127.0.0.1:8765/*",
    "https://*.workers.dev/*"
  ],
  "action": {
    "default_title": "Skyhop Airline Assist"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8765/*",
        "http://127.0.0.1:8765/*",
        "https://alon24.github.io/AiTravelSearcher/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
