{
  "manifest_version": 3,
  "name": "Skyhop Airline Assist",
  "version": "0.3.3",
  "description": "From a Skyhop flight result, open the airline's own site in a new tab with that flight already selected, so you can finish booking it yourself.",
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "https://www.elal.com/*",
    "https://booking.elal.com/*"
  ],
  "action": { "default_title": "Skyhop Airline Assist" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost:8765/*", "http://127.0.0.1:8765/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
