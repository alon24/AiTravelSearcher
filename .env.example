# Provider: mock | gflights (free scraper, no key) | serpapi (credits). Comma list = fallback order.
FLIGHTAGENT_PROVIDER=gflights,serpapi
SERPAPI_API_KEY=
# Optional
FLIGHTAGENT_CACHE_DB=.cache/offers.sqlite
FLIGHTAGENT_CACHE_TTL_HOURS=6
# Diagnostic only: classify *why* a gflights scrape failed to parse (consent/captcha/blocked/...)
# instead of one generic message. Calls a shared local Laya service (~/laya-service, started
# separately with `~/laya-service/start.sh`) -- no extra dependency in this project. Leave
# unset/0 to skip it entirely.
FLIGHTAGENT_LAYA=0
FLIGHTAGENT_LAYA_URL=http://127.0.0.1:8799
