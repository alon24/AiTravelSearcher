# Provider: mock | gflights (free scraper, no key) | serpapi (credits). Comma list = fallback order.
FLIGHTAGENT_PROVIDER=gflights,serpapi
SERPAPI_API_KEY=
# Price verification (docs/DESIGN.md section 8): a second, independent provider that re-checks the prices of the
# trips you pick ("Verify" buttons on the results screen). Must differ from the first FLIGHTAGENT_PROVIDER. Off when unset.
# FLIGHTAGENT_VERIFIER=serpapi
# Optional
FLIGHTAGENT_CACHE_DB=.cache/offers.sqlite
FLIGHTAGENT_CACHE_TTL_HOURS=6
# Diagnostic only: classify *why* a gflights scrape failed to parse (consent/captcha/blocked/...)
# instead of one generic message. Calls a shared local Laya service (~/laya-service, started
# separately with `~/laya-service/start.sh`) -- no extra dependency in this project. Leave
# unset/0 to skip it entirely.
FLIGHTAGENT_LAYA=0
FLIGHTAGENT_LAYA_URL=http://127.0.0.1:8799

# Decision model for finding elements on airline pages (Assist) and for the scrape diagnostics above:
#   laya = the local service (free, needs ~/laya-service running), jev = TypeSafe's hosted Jev via OpenRouter
#   (input tokens only, ~$0.04 per million). The OpenRouter key stays on this server -- the extension calls
#   /api/decide here instead of holding it. The Assist switch is the "Laya/Jev" badge in the Skyhop page header.
FLIGHTAGENT_DECIDER=laya
# OPENROUTER_API_KEY=sk-or-...        (OPENROUTER_KEY also works)
# FLIGHTAGENT_JEV_MODEL=typesafe/jev-1.13   # or ~typesafe/jev-latest (newest release; behaviour may change)

# Natural-language chat, built in (chat.py: `flightagent-chat` on the CLI, or POST /api/chat) -- replaced the old
# n8n workflow, no separate app needed. Uses the SAME OpenRouter key as above.
# FLIGHTAGENT_CHAT_MODEL=openai/gpt-4o-mini
